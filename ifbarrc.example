#!/usr/bin/env bash

# Copy this file to ifbarrc and uncomment what you want to change:
#
#   cp ifbarrc.example ifbarrc
#
# Anything left commented out falls back to the defaults in lua/config.lua.
# The file is parsed, not executed, so only "export NAME=value" lines count.
# $COLOR_* names are resolved against the active theme: every base color has
# COLOR_<NAME> plus COLOR_<NAME>_75, _50 and _25 alpha variants. A name the
# theme does not define resolves to nothing, which leaves the widget colorless.

# ========== Theme ==========
# ayudark ayulight blossomlight githubdark githublight gruvboxdark
# gruvboxlight nord onedark onelight tokyonight
# export IF_BAR_THEME="onedark"

# ========== Bar ==========
# export IF_BAR_HEIGHT=56
# export IF_BAR_POSITION="top"
# export IF_BAR_BACKGROUND="transparent"

# ========== Fonts ==========
# export IF_BAR_LABEL_FONT_FAMILY="SpaceMono Nerd Font Mono"
# export IF_BAR_ICON_FONT_FAMILY="SpaceMono Nerd Font Mono"
# export IF_BAR_LABEL_FONT_SIZE=12
# export IF_BAR_ICON_FONT_SIZE=18
# export IF_BAR_APP_ICON_FONT_SIZE=13.5

# The session icons can carry their own size. A glyph that is wide and flat
# fills less of its box vertically than a squarer one, so it reads smaller at
# the same point size. Defaults to IF_BAR_APP_ICON_FONT_SIZE.
# IF_BAR_CLAUDE_ICON_SIZE=18.0

# ========== Widgets ==========
# Space-separated lists, in display order.
# Available: space front_app clock calendar weather caffeinate volume
#            battery disk ram cpu netstat kakaotalk
#            last_command running_command claude
# export IF_BAR_WIDGETS_LEFT_ENABLED="space"
# export IF_BAR_WIDGETS_CENTER_ENABLED="front_app"
# export IF_BAR_WIDGETS_RIGHT_ENABLED="clock weather caffeinate volume battery disk ram cpu kakaotalk"

# ========== Widget options ==========
# export IF_BAR_CLOCK_FORMAT="MM/DD HH:mm"
# export IF_BAR_CALENDAR_FORMAT="YYYY-MM-DD"
# export IF_BAR_WEATHER_LOCATION="Seoul"
# export IF_BAR_FRONT_APP_VISIBLE=true
# export IF_BAR_CPU_SHOW_GRAPH=true
# export IF_BAR_CPU_SHOW_PERCENT=true
# export IF_BAR_RAM_SHOW_GRAPH=true
# export IF_BAR_RAM_SHOW_PERCENT=true
# export IF_BAR_NETSTAT_SHOW_GRAPH=true
# export IF_BAR_NETSTAT_SHOW_SPEED=false

# ========== Shell command widgets ==========
# last_command and running_command put the commands you run on screen.
# Read the security note in the README before enabling them on a machine you
# share or present from. Both need the zsh hook.
# export IF_BAR_LAST_COMMAND_MAX_LENGTH=60
#
# IF_BAR_RUNNING_DELAY is read by the zsh hook, not from this file, because
# this file is parsed rather than sourced. Export it in your .zshrc instead:
#   export IF_BAR_RUNNING_DELAY=2

# ========== Claude sessions ==========
# Needs the Claude Code hooks; see README.
# export IF_BAR_CLAUDE_MAX_SESSIONS=8

# ========== Update frequency (seconds) ==========
# export IF_BAR_ITEM_UPDATE_FREQ_FAST=2
# export IF_BAR_ITEM_UPDATE_FREQ_DEFAULT=10
# export IF_BAR_ITEM_UPDATE_FREQ_SLOW=30

# ========== Spacing ==========
# export IF_BAR_SPACER_WIDTH=8
# export IF_BAR_GROUP_GAP=20

# ========== Colors ==========
# export IF_BAR_COLOR_CLOCK="$COLOR_YELLOW"
# export IF_BAR_COLOR_CALENDAR="$COLOR_TANGERINE"
# export IF_BAR_COLOR_WEATHER="$COLOR_CYAN"
# export IF_BAR_COLOR_CAFFEINATE="$COLOR_GREEN"
# export IF_BAR_COLOR_CAFFEINATE_ON="$COLOR_YELLOW"
# export IF_BAR_COLOR_VOLUME="$COLOR_BLUE"
# export IF_BAR_COLOR_BATTERY="$COLOR_ORANGE"
# export IF_BAR_COLOR_DISK="$COLOR_RED"
# export IF_BAR_COLOR_RAM="$COLOR_MAGENTA"
# export IF_BAR_COLOR_CPU="$COLOR_BLUE"
# export IF_BAR_COLOR_NETSTAT="$COLOR_TANGERINE"
# export IF_BAR_COLOR_KAKAOTALK="$COLOR_YELLOW"
# export IF_BAR_COLOR_FRONT_APP="$COLOR_GREEN"
# export IF_BAR_COLOR_LAST_COMMAND="$COLOR_CYAN"
# export IF_BAR_COLOR_LAST_COMMAND_ERROR="$COLOR_RED"
# export IF_BAR_COLOR_LAST_COMMAND_CLAUDE="$COLOR_MAGENTA"
# export IF_BAR_COLOR_RUNNING_COMMAND="$COLOR_YELLOW"
# export IF_BAR_COLOR_RUNNING_COMMAND_CLAUDE="$COLOR_MAGENTA"
